---
interface Props {
  tone?: 'light' | 'dark'
  marker?: boolean
  class?: string
}

const { tone = 'dark', marker = true, class: className = '' } = Astro.props

// A página toda é escura: `dark` (padrão) é o eyebrow de seção, `light` o de bloco em destaque.
const toneClasses = tone === 'light' ? 'text-white/80' : 'text-white/60'
---

<span
  class={`
    inline-flex items-center gap-2.5
    font-sans text-[12px] font-semibold uppercase tracking-[0.16em]
    ${toneClasses} ${className}
  `}
>
  {marker && <span class="h-[6px] w-[6px] bg-neon shadow-[0_0_8px_1px_rgba(62,227,159,0.7)]" />}
  <slot />
</span>
