---
/**
 * Como funciona — fase "apoio" da biblioteca B2.
 *
 * Variante local da Print Master, LP de notebooks (19/11/2026, docs/BRIEFING.md):
 * cabeçalho com o botão e a garantia à direita, e as etapas em 4 cards com degradê verde
 * e borda menta, número em amarelo — eles são o bloco "navy" desta metade da página.
 * Fundo e respiro continuam vindo da composição via `tone`/`rhythm`; o brilho é uma
 * camada por cima do tom.
 */
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { process } from '@data/sections/processo'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const steps = process.steps
---

<Section id="processo" tone={tone} rhythm={rhythm} data-processo>
  <div class="pt-10 lg:pt-14">
    <div class="flex flex-col gap-7 lg:flex-row lg:items-start lg:justify-between lg:gap-12">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-3 font-sans text-[12.5px] font-bold tracking-[0.22em] text-white/60 uppercase">
          <span
            aria-hidden="true"
            class="size-3 rounded-[3px] bg-neon shadow-[0_0_10px_rgba(62,227,159,0.7)]"
          ></span>
          {process.eyebrow}
        </span>
        <h2 class="mt-4 font-display text-[2.2rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-white sm:text-5xl lg:text-[3.35rem]">
          {process.title}
        </h2>
        <p class="mt-4 font-sans text-[17px] leading-relaxed text-white/70 sm:text-lg">
          {process.text}
        </p>
      </div>

      <div class="flex flex-col items-stretch gap-3 sm:items-start lg:shrink-0 lg:pt-3">
        <button
          type="button"
          data-cta="processo-cta"
          class="btn-slave-whats group inline-flex items-center justify-center gap-4 rounded-full bg-neon px-8 py-4 font-sans text-[16px] font-bold text-night-950 shadow-[0_18px_40px_-16px_rgba(62,227,159,0.7)] transition-colors duration-200 hover:bg-mint"
        >
          {process.cta}
          <Icon
            name="arrow-right"
            class="size-5 transition-transform duration-200 group-hover:translate-x-0.5"
          />
        </button>
        <span class="flex items-center gap-2 pl-1 font-sans text-[14px] text-white/65">
          <Icon name="shield" class="size-4 shrink-0 text-neon" />
          {process.microcopy}
        </span>
      </div>
    </div>

    <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" aria-label={process.eyebrow}>
      {steps.map((step, i) => (
        <li class="process-card relative flex flex-col overflow-hidden rounded-2xl p-7 ring-1 ring-mint/25 shadow-[0_26px_50px_-30px_rgba(0,0,0,0.9)] lg:p-8">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-16 -right-16 size-40 rounded-full bg-neon/15 blur-2xl"
          />
          <span class="relative font-display text-[2.6rem] leading-none font-extrabold tracking-[-0.03em] text-sun glow-sun">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span aria-hidden="true" class="relative mt-4 block h-[3px] w-10 rounded-full bg-neon" />
          <h3 class="relative mt-5 font-display text-[1.35rem] leading-snug font-extrabold text-white lg:text-[1.15rem] xl:text-[1.25rem]">
            {step.title}
          </h3>
          <p class="relative mt-3 font-sans text-[16px] leading-relaxed text-white/75">
            {step.description}
          </p>
          {step.when && (
            <span class="relative mt-4 inline-flex w-fit items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 font-sans text-[11px] font-bold tracking-[0.12em] text-white/85 uppercase">
              <Icon name="clock" class="size-3.5 shrink-0 text-mint" />
              {step.when}
            </span>
          )}
        </li>
      ))}
    </ol>
  </div>
</Section>

<style>
  /* Camada sobre o tom da seção: sai do escuro de `linhas` e chega no escuro alternado
     de `aplicacoes`, sem emenda entre as três. */
  :global([data-processo]) {
    background-image: linear-gradient(
      180deg,
      var(--color-night-900) 0%,
      var(--color-night-800) 70%,
      var(--color-night-800) 100%
    );
  }

  .process-card {
    background-image:
      radial-gradient(120% 80% at 100% 0%, rgb(62 227 159 / 0.12) 0%, transparent 60%),
      linear-gradient(160deg, #0b3527 0%, var(--color-night-700) 100%);
  }
</style>
