---
/**
 * Linhas de produto — fase "oferta" da biblioteca B2.
 *
 * Variante local da Print Master, LP de notebooks (19/11/2026, docs/BRIEFING.md):
 * cabeçalho com ajuda à direita, 3 cards escuros com a foto do notebook em palco de luz
 * verde, etiqueta (amarela no card em oferta), linha de preço opcional, 2 características e
 * botão de proposta; abaixo, as marcas por extenso. Fundo e respiro vêm da composição via
 * `tone`/`rhythm`; o brilho verde é uma camada por cima do tom.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import Eyebrow from '@components/Eyebrow.astro'
import type { SectionProps } from '@lib/layout'
import { productLines } from '@data/sections/linhas'
import type { ProductLine } from '@data/sections/linhas'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const lines: readonly ProductLine[] = productLines.items
---

<Section id="linhas" tone={tone} rhythm={rhythm} data-linhas>
  <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-10">
    <div class="max-w-3xl">
      <Eyebrow>{productLines.eyebrow}</Eyebrow>
      <h2 class="mt-4 font-display text-[2.2rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-white sm:text-5xl lg:text-[3.35rem]">
        {productLines.title}
      </h2>
      <p class="mt-4 font-sans text-[17px] leading-relaxed text-white/70 sm:text-lg">
        {productLines.text}
      </p>
    </div>

    <div class="shrink-0 lg:pb-2">
      <p class="font-sans text-[15px] font-medium text-white/85">{productLines.help.text}</p>
      <button
        type="button"
        data-cta="linhas-ajuda"
        class="btn-slave-whats group mt-3 inline-flex items-center gap-3 rounded-full border-2 border-mint px-6 py-3 font-sans text-[15px] font-bold text-mint transition-colors duration-200 hover:bg-mint hover:text-night-950"
      >
        {productLines.help.cta}
        <Icon
          name="arrow-right"
          class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
        />
      </button>
    </div>
  </div>

  <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" aria-label={productLines.eyebrow}>
    {lines.map((line) => (
      <li
        class:list={[
          'linhas-card group flex flex-col rounded-[22px] border bg-night-700 p-3 shadow-[0_26px_50px_-30px_rgba(0,0,0,0.9)] transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_32px_64px_-30px_rgba(62,227,159,0.4)]',
          line.promo ? 'border-sun/40 hover:border-sun/70' : 'border-white/10 hover:border-mint/50',
        ]}
      >
        {/* Palco da foto */}
        <div class="linhas-stage relative aspect-[4/3] overflow-hidden rounded-2xl">
          <Image
            src={line.photo.src}
            alt={line.photo.alt}
            format="webp"
            width={720}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
          />
          <span
            class:list={[
              'absolute top-3 left-3 z-[2] rounded-full px-3 py-1.5 font-sans text-[10.5px] font-extrabold tracking-[0.1em] uppercase',
              line.promo
                ? 'bg-sun text-night-950'
                : 'bg-night-950/70 text-mint ring-1 ring-mint/50 backdrop-blur-sm',
            ]}
          >
            {line.tag}
          </span>
        </div>

        {/* Conteúdo */}
        <div class="flex flex-1 flex-col px-3 pt-5 pb-3">
          <h3 class="font-display text-[1.35rem] leading-snug font-extrabold text-white">
            {line.title}
          </h3>
          <p class="mt-2 font-sans text-[15px] leading-relaxed text-white/65">{line.description}</p>

          {line.promo && (
            <p class="mt-3 font-display text-[1.45rem] leading-tight font-extrabold text-sun glow-sun">
              {line.promo}
            </p>
          )}

          <ul class="mt-4 mb-6 flex flex-col gap-2.5">
            {line.features.map((feature) => (
              <li class="flex items-center gap-2.5 font-sans text-[14.5px] text-white/90">
                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-neon/10 text-neon ring-1 ring-neon/40">
                  <Icon name="check" class="size-3.5" />
                </span>
                {feature}
              </li>
            ))}
          </ul>

          <button
            type="button"
            data-cta={`linhas-${line.id}`}
            class:list={[
              'btn-slave-whats mt-auto flex w-full items-center justify-between gap-3 rounded-full px-6 py-3.5 font-sans text-[15px] font-bold transition-colors duration-200',
              line.promo
                ? 'bg-neon text-night-950 hover:bg-mint'
                : 'border border-mint/50 text-mint hover:bg-mint hover:text-night-950',
            ]}
          >
            <span>{productLines.itemCta}</span>
            <Icon name="arrow-right" class="size-4 shrink-0" />
          </button>
        </div>
      </li>
    ))}
  </ul>

  {/* Faixa de marcas, por extenso */}
  <div class="mt-14">
    <div class="flex items-center gap-5">
      <span aria-hidden="true" class="h-px flex-1 bg-white/15"></span>
      <p class="text-center font-sans text-[11.5px] font-bold tracking-[0.2em] text-white/55 uppercase">
        {productLines.brandsLabel}
      </p>
      <span aria-hidden="true" class="h-px flex-1 bg-white/15"></span>
    </div>
    <ul
      class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-3 sm:gap-x-16"
      aria-label={productLines.brandsLabel}
    >
      {productLines.brandNames.map((name) => (
        <li class="font-display text-[1.9rem] font-extrabold tracking-[0.06em] text-white/45 uppercase transition-colors duration-200 hover:text-white sm:text-[2.3rem]">
          {name}
        </li>
      ))}
      <li class="font-sans text-[15px] font-semibold text-mint">+ {productLines.brandsMore}</li>
    </ul>
  </div>
</Section>

<style>
  /* Brilho verde sobre o tom da seção */
  :global([data-linhas]) {
    background-image: radial-gradient(
      900px 420px at 85% 0%,
      rgb(62 227 159 / 0.08) 0%,
      transparent 70%
    );
  }

  /* Palco escuro com luz verde sob o produto (aparece atrás da arte recortada) */
  .linhas-stage {
    background-image:
      radial-gradient(ellipse 70% 55% at 50% 72%, rgb(62 227 159 / 0.28) 0%, transparent 72%),
      linear-gradient(180deg, #04170f 0%, #010b07 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .linhas-card,
    .linhas-card * {
      transition: none !important;
    }
    .linhas-card:hover {
      transform: none;
    }
  }
</style>
