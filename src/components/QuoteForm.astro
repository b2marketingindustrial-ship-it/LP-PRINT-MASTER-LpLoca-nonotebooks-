---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.4). Grid 1.05fr · 1fr: formulário (shortcode) à esquerda, texto à direita.
 * Mobile: texto antes do formulário. O formulário é sempre o shortcode, nunca um <form> próprio.
 *
 * Visual dos posts da campanha de notebooks (19/11/2026, docs/BRIEFING.md): fundo escuro
 * alternado (`bg-night-800`, o tom "gray" da composição) com brilho verde, título com o trecho
 * final em menta e selos com divisórias. A coluna do formulário é um espaço reservado: no
 * WordPress o plugin de atendimento preenche o formulário; fora dele, o texto cru do shortcode é
 * apagado pelo script do Hero. Abaixo do texto, o botão "Chamar no WhatsApp" (`cotacao-whatsapp`),
 * de volta em 24/11/2026: na LP de impressoras ele tinha virado espaço vazio a pedido do cliente.
 */
import Button from './Button.astro'
import Icon from './Icon.astro'
import { cta, quote } from '../data/content'

const isDev = import.meta.env.DEV

const at = quote.title.indexOf(quote.highlight)
const titleBefore = at >= 0 ? quote.title.slice(0, at) : quote.title
---

<section
  id="cotacao"
  class="quote-section relative isolate overflow-hidden bg-night-800 pt-8 pb-20"
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 -left-32 -z-10 size-[520px] rounded-full bg-neon/10 blur-3xl"
  ></span>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -right-40 -bottom-48 -z-10 size-[480px] rounded-full bg-sun/[0.05] blur-3xl"
  ></span>

  <div class="mx-auto max-w-page px-6 pt-10 lg:px-10 lg:pt-14">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:items-center lg:gap-16">
      {/* Coluna do formulário: espaço reservado para o shortcode do plugin */}
      <div class="order-2 w-full lg:order-1">
        <div class="flex min-h-[520px] flex-col" data-shortcode-slot>
          <slot name="shortcode">
            {isDev ? (
              <div
                class="flex min-h-[520px] w-full flex-col gap-3 rounded-2xl border border-white/10 bg-night-700 p-6"
                aria-label="Mock do formulário (só em desenvolvimento)"
              >
                <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-mint uppercase">
                  Mock · formulário
                </span>
                <div class="grid gap-3 sm:grid-cols-2">
                  <div class="h-11 rounded border border-white/10 bg-white/5" />
                  <div class="h-11 rounded border border-white/10 bg-white/5" />
                  <div class="h-11 rounded border border-white/10 bg-white/5" />
                  <div class="h-11 rounded border border-white/10 bg-white/5" />
                  <div class="h-28 rounded border border-white/10 bg-white/5 sm:col-span-2" />
                </div>
                <div class="mt-auto h-12 w-full rounded-full bg-neon/80 sm:w-48" />
              </div>
            ) : (
              <div class="flex min-h-[520px] w-full flex-col items-center justify-center gap-3 rounded-2xl border border-dashed border-white/20 p-8 text-center">
                <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-mint uppercase">
                  Espaço reservado
                </span>
                <p class="font-display text-lg font-bold text-white">
                  Shortcode — formulário de cotação
                </p>
              </div>
            )}
          </slot>
        </div>
      </div>

      {/* Coluna de texto */}
      <div class="order-1 lg:order-2">
        <span class="inline-flex items-center gap-4 font-sans text-[12.5px] font-semibold tracking-[0.2em] text-white/80 uppercase">
          <span
            aria-hidden="true"
            class="h-[3px] w-10 rounded-full bg-neon shadow-[0_0_10px_rgba(62,227,159,0.8)]"
          ></span>
          {quote.eyebrow}
        </span>

        <h2 class="mt-5 font-display text-[2.4rem] leading-[1.04] font-extrabold tracking-[-0.03em] text-white sm:text-5xl lg:text-[3.1rem] xl:text-[3.5rem]">
          {titleBefore}
          {at >= 0 && <span class="block text-mint glow-neon">{quote.highlight}</span>}
        </h2>

        <p class="mt-6 font-sans text-[17px] leading-relaxed text-white/75 sm:text-[19px]">
          {quote.text}
        </p>

        <p class="mt-8 font-sans text-[16px] font-medium text-white/85">{quote.whatsappLead}</p>
        <Button
          cta="cotacao-whatsapp"
          iconName="whatsapp"
          iconPosition="left"
          class="mt-4 w-full rounded-full shadow-[0_18px_40px_-14px_rgba(62,227,159,0.75)] sm:w-auto"
        >
          {cta.whatsapp}
        </Button>

        <span aria-hidden="true" class="mt-9 block h-px bg-white/15"></span>

        <ul
          class="mt-7 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:gap-x-0"
          aria-label="Garantias"
        >
          {quote.trust.map((item) => (
            <li class="flex items-center gap-3 sm:border-l sm:border-white/15 sm:px-4 sm:first:border-l-0 sm:first:pl-0">
              <Icon name={item.icon} class="size-7 shrink-0 text-neon" />
              <span class="max-w-[8.5rem] font-sans text-[13.5px] leading-snug font-medium text-balance text-white/90 sm:text-[15px]">
                {item.label}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .quote-section {
    background-image:
      radial-gradient(1000px 520px at 15% -10%, rgb(62 227 159 / 0.14) 0%, transparent 60%),
      linear-gradient(
        165deg,
        var(--color-night-700) 0%,
        var(--color-night-800) 55%,
        var(--color-night-950) 100%
      );
  }
</style>
