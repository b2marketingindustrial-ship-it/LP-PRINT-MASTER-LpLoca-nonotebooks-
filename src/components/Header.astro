---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.1), com o visual dos posts da campanha de notebooks
 * (19/11/2026 — docs/BRIEFING.md): barra escura translúcida, logo branco com o ícone menta e
 * CTA em pílula de contorno menta, como o "Solicite sua proposta." dos posts. A ordem continua
 * a do padrão — logo · tagline · CTA —, sem menu nem âncoras.
 */
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import logo from '../assets/LOGO.png'
import { site } from '../data/site'
import { header, cta } from '../data/content'
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-night-950/75 backdrop-blur-md">
  <div class="mx-auto flex max-w-page items-center justify-between gap-3 px-4 py-3 sm:gap-6 sm:px-6 lg:px-10">
    {/* 1. Logo */}
    <a href="/" class="flex shrink-0 items-center">
      <Image
        src={logo}
        alt={site.brand}
        width={262}
        height={60}
        format="webp"
        loading="eager"
        fetchpriority="low"
        decoding="async"
        class="h-9 w-auto sm:h-11 lg:h-[48px]"
      />
    </a>

    {/* 2. Tagline central (some no mobile) */}
    <span class="hidden flex-1 items-center justify-center gap-2.5 font-display text-[13px] font-bold tracking-[0.18em] text-white/70 uppercase md:flex lg:text-[14px]">
      <span
        aria-hidden="true"
        class="size-1.5 rounded-full bg-neon shadow-[0_0_10px_2px_rgba(62,227,159,0.7)]"
      ></span>
      {header.tagline}
    </span>

    {/* 3. CTA em pílula menta, rótulo curto no mobile */}
    <button
      type="button"
      data-cta="header-cta"
      class="btn-slave-whats inline-flex shrink-0 items-center gap-2 rounded-full border-2 border-mint px-4 py-2 font-sans text-[12px] font-bold text-mint shadow-[0_0_24px_-8px_rgba(103,223,167,0.6)] transition-colors duration-200 hover:bg-mint hover:text-night-950 sm:px-6 sm:py-2.5 sm:text-[14px]"
    >
      <Icon name="whatsapp" class="size-4 shrink-0" />
      <span class="sm:hidden">{cta.primaryShort}</span>
      <span class="hidden sm:inline">{cta.primary}</span>
    </button>
  </div>
</header>
